FROM python:3.9-slim

# Set working directory
WORKDIR /app

# Copy requirements and install dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy the web API code
COPY . .

# Copy the cvm-attestation code (needed for imports)
COPY ../cvm-attestation /app/cvm-attestation

# Expose port
EXPOSE 5000

# Run the application
CMD ["python", "app.py"]